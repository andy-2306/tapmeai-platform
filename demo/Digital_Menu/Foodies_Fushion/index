        // Initialization
        document.addEventListener('DOMContentLoaded', () => {
            renderNavigation();
            renderMenu();
        });

        // Render Top Navigation Pills
        function renderNavigation() {
            const navContainer = document.getElementById('categoryNav');
            
            // Add "All" button
            const allBtn = document.createElement('button');
            allBtn.className = 'cat-pill active';
            allBtn.innerText = 'All Items';
            allBtn.onclick = () => scrollToCategory('all', allBtn);
            navContainer.appendChild(allBtn);

            // Add Category Buttons
            menuData.forEach(cat => {
                const btn = document.createElement('button');
                btn.className = 'cat-pill';
                btn.innerText = cat.title;
                btn.onclick = () => scrollToCategory(cat.id, btn);
                navContainer.appendChild(btn);
            });
        }

        // Render the Main Menu Sections
        function renderMenu() {
            const menuContainer = document.getElementById('menuContainer');
            menuContainer.innerHTML = '';

            menuData.forEach(category => {
                // Create Section
                const section = document.createElement('div');
                section.className = 'menu-section';
                section.id = category.id;

                // Create Title
                const title = document.createElement('h2');
                title.className = 'section-title';
                
                // Add icon based on category type
                const icon = category.type === 'veg' ? '🌿' : '🍗';
                title.innerHTML = `${icon} ${category.title}`;
                section.appendChild(title);

                // Create Item Cards
                category.items.forEach(item => {
                    const card = document.createElement('div');
                    card.className = 'item-card';
                    card.setAttribute('data-search', item.name.toLowerCase());

                    const indicatorClass = category.type === 'veg' ? 'veg-indicator' : 'veg-indicator nonveg-indicator';

                    card.innerHTML = `
                        <div class="item-info">
                            <div class="item-header">
                                <div class="${indicatorClass}"></div>
                                <h3 class="item-name">${item.name}</h3>
                            </div>
                        </div>
                        <div class="item-price">₹${item.price}</div>
                    `;
                    section.appendChild(card);
                });

                menuContainer.appendChild(section);
            });
        }

        // Scroll to Category and Update Active Pill
        function scrollToCategory(id, btnElement) {
            // Update Active State
            document.querySelectorAll('.cat-pill').forEach(btn => btn.classList.remove('active'));
            btnElement.classList.add('active');

            // Handle Scroll
            if (id === 'all') {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                const section = document.getElementById(id);
                // Offset for sticky header/nav
                const y = section.getBoundingClientRect().top + window.scrollY - 150;
                window.scrollTo({ top: y, behavior: 'smooth' });
            }
        }

        // Live Search Filter Engine
        function filterMenu() {
            const input = document.getElementById('searchInput').value.toLowerCase();
            const sections = document.querySelectorAll('.menu-section');
            let hasVisibleItems = false;

            sections.forEach(section => {
                const cards = section.querySelectorAll('.item-card');
                let sectionHasMatch = false;

                cards.forEach(card => {
                    const itemName = card.getAttribute('data-search');
                    if (itemName.includes(input)) {
                        card.style.display = 'flex';
                        sectionHasMatch = true;
                        hasVisibleItems = true;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Hide entire section if no items match inside it
                section.style.display = sectionHasMatch ? 'block' : 'none';
            });

            // Show/Hide "No Results" message
            document.getElementById('noResults').style.display = hasVisibleItems ? 'none' : 'block';
        }
